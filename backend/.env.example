# ---- SmartKassa Backend (.env.example) ----
# Nusxasini oling:  cp .env.example .env
# Barcha qadriyatlar lokal ishlashga mos, production'da o'zgartiring.

# Django xavfsizlik kaliti — production'da tasodifiy uzun satr qo'ying
# (masalan: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=change-me-in-production

# Ruxsat etilgan hostlar (vergul bilan ajrating)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# True — ishlab chiqish rejimi (xatolarni ko'rsatadi), False — production
DEBUG=True

# PostgreSQL (Render'da DATABASE_URL avtomatik beriladi; lokal uchun keltirilgan misol)
# Agarda ko'rsatilmasa — sqlite:///backend/db.sqlite3 ishlatiladi
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartkassa

# CORS — frontend (Vercel) manzillari
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://smartkassa.vercel.app

# Render build.sh owner superuser yaratish uchun (ixtiyoriy)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@smartkassa.uz
DJANGO_SUPERUSER_PASSWORD=admin123
