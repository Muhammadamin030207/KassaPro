# ---- SmartKassa Frontend (.env.example) ----
# Nusxasini oling:  cp .env.example .env.local
# Lokal ishlashda VITE_API_URL ko'rsatish SHART EMAS — Vite "/api" so'rovlarini
# backendga proksi qiladi (vite.config.js ichidagi VITE_PROXY_TARGET).
# Faqat Vercel/ishlab chiqarish uchun API manzilini o'rnating:

# VITE_API_URL=https://smartkassa-backend.onrender.com/api

# Lokal muhitda backend porti boshqacha bo'lsa (masalan 8001):
# VITE_PROXY_TARGET=http://127.0.0.1:8001